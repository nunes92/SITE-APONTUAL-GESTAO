        const WHATSAPP_NUMBER = "5562984227130";

        /**
         * Dispara o evento de conversão do Google Ads (quando configurado) e abre o WhatsApp
         * @param {string} mensagem - Texto pré-preenchido que aparecerá no WhatsApp do lead
         * @param {string} origem - Identificador do botão clicado para rastreamento
         */
        function abrirWhatsApp(mensagem, origem) {
            try {
                // Disparo de conversão para Google Ads (gtag) / Google Tag Manager (dataLayer)
                if (typeof gtag === 'function') {
                    gtag('event', 'conversion', {
                        'send_to': 'AW-XXXXXXXXX/YYYYYYYYYYY', // Substituir pelo rótulo de conversão
                        'event_category': 'WhatsApp',
                        'event_label': origem
                    });
                }
                if (window.dataLayer) {
                    window.dataLayer.push({
                        'event': 'whatsapp_click',
                        'cta_location': origem
                    });
                }
            } catch (e) {
                console.warn('Tracking ignorado:', e);
            }

            const url = `https://wa.me/WHATSAPPNUMBER?text={encodeURIComponent(mensagem)}`;
            window.open(url, '_blank', 'noopener,noreferrer');
        }

        // Atualiza ano automático no rodapé
        document.getElementById('current-year').textContent = new Date().getFullYear();

        // Interatividade do Accordion (FAQ)
        document.querySelectorAll('.faq-trigger').forEach(button => {
            button.addEventListener('click', () => {
                const currentItem = button.parentElement;
                const isAlreadyActive = currentItem.classList.contains('active');

                // Fecha todos os itens abertos para manter a interface limpa
                document.querySelectorAll('.faq-item').forEach(item => {
                    item.classList.remove('active');
                });

                if (!isAlreadyActive) {
                    currentItem.classList.add('active');
                }
            });
        });

        // Máscara simples de telefone brasileiro no campo WhatsApp
        const inputWhatsapp = document.getElementById('whatsapp');
        inputWhatsapp.addEventListener('input', function (e) {
            let v = e.target.value.replace(/\D/g, '');
            if (v.length > 11) v = v.slice(0, 11);
            if (v.length > 6) {
                e.target.value = `(${v.slice(0, 2)}) v.slice(2,7)-{v.slice(7)}`;
            } else if (v.length > 2) {
                e.target.value = `(${v.slice(0, 2)}) ${v.slice(2)}`;
            } else if (v.length > 0) {
                e.target.value = `(${v}`;
            }
        });

        // Envio do formulário rápido diretamente formatado para o WhatsApp
        document.getElementById('lead-form').addEventListener('submit', function (e) {
            e.preventDefault();
            const nome = document.getElementById('nome').value.trim();
            const telefone = document.getElementById('whatsapp').value.trim();
            const necessidade = document.getElementById('necessidade').value;

            const mensagemFormatada = `Olá! Meu nome é *nome*({telefone}). Vim pelo Google e preciso de ajuda com: *${necessidade}*.`;
            abrirWhatsApp(mensagemFormatada, 'formulario_rapido');
        });
    </script>
</body>
